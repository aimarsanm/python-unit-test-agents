{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Descargar según respuestas Sí/No",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\manage-components.ps1",
        "-Mode",
        "download",
        "-WantsAgents",
        "${input:quieresAgents}",
        "-WantsSkills",
        "${input:quieresSkills}",
        "-WantsReadme",
        "${input:quieresReadme}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Comprobar actualizaciones de componentes",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\manage-components.ps1",
        "-Mode",
        "update"
      ],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ],
  "inputs": [
    {
      "id": "quieresAgents",
      "type": "pickString",
      "description": "¿Deseas descargar los Agentes (.github/agents)?",
      "options": [
        "Sí",
        "No"
      ],
      "default": "Sí"
    },
    {
      "id": "quieresSkills",
      "type": "pickString",
      "description": "¿Deseas descargar las Skills (.github/skills)?",
      "options": [
        "Sí",
        "No"
      ],
      "default": "Sí"
    },
    {
      "id": "quieresReadme",
      "type": "pickString",
      "description": "¿Deseas descargar el README.md?",
      "options": [
        "Sí",
        "No"
      ],
      "default": "No"
    }
  ]
}
