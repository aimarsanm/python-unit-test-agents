{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Descargar según respuestas Sí/No",
      "type": "process",
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/manage-components-linux.sh",
          "--mode", "download",
          "--wants-agents", "${input:quieresAgents}",
          "--wants-skills", "${input:quieresSkills}",
          "--wants-readme", "${input:quieresReadme}"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/manage-components-linux.sh",
          "--mode", "download",
          "--wants-agents", "${input:quieresAgents}",
          "--wants-skills", "${input:quieresSkills}",
          "--wants-readme", "${input:quieresReadme}"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}/.vscode/manage-components-windows.ps1",
          "-Mode", "download",
          "-WantsAgents", "${input:quieresAgents}",
          "-WantsSkills", "${input:quieresSkills}",
          "-WantsReadme", "${input:quieresReadme}"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Comprobar actualizaciones de componentes",
      "type": "process",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/manage-components-linux.sh",
          "--mode", "update"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/manage-components-linux.sh",
          "--mode", "update"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}/.vscode/manage-components-windows.ps1",
          "-Mode", "update"
        ]
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "quieresAgents",
      "type": "pickString",
      "description": "¿Deseas descargar los Agentes (.github/agents)?",
      "options": ["Sí", "No"],
      "default": "Sí"
    },
    {
      "id": "quieresSkills",
      "type": "pickString",
      "description": "¿Deseas descargar las Skills (.github/skills)?",
      "options": ["Sí", "No"],
      "default": "Sí"
    },
    {
      "id": "quieresReadme",
      "type": "pickString",
      "description": "¿Deseas descargar el README.md?",
      "options": ["Sí", "No"],
      "default": "No"
    }
  ]
}